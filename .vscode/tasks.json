{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure (default)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "default"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build Interactive Mandelbrot",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "default",
        "--target",
        "Main"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Build Plotting App",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "default",
        "--target",
        "Plotting"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Build Complex Number Unit Tests",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "default",
        "--target",
        "TestComplexNumbers"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build Mandelbrot Membership Tests",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "default",
        "--target",
        "TestMandelbrot"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build App Logic Unit Tests",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "default",
        "--target",
        "TestApps"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run Interactive Mandelbrot (No Debugger)",
      "type": "shell",
      "command": "${workspaceFolder}/.build/default/bin/Main",
      "dependsOn": "Build Interactive Mandelbrot",
      "problemMatcher": []
    }
  ]
}
