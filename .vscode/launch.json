{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Main App (No Debugger, Interactive Mandelbrot Prompt)",
      "type": "node-terminal",
      "request": "launch",
      "command": "cmake --build --preset default --target Main && \"${workspaceFolder}/.build/default/bin/Main\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Main App (Interactive Mandelbrot Prompt)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/Main",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Main App",
      "targetArchitecture": "arm64",
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Run Plotting App (Interactive GNUplot Window)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/Plotting",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Plotting App",
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Run Plotting App (No GNUplot, Non-interactive)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/Plotting",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Plotting App",
      "environment": [
        {
          "name": "PLOTTING_APP_NO_GNUPLOT",
          "value": "1"
        }
      ],
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Run Complex Number Unit Tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/TestComplexNumbers",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Complex Number Unit Tests",
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Run Mandelbrot Membership Unit Tests (Non-interactive)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/TestMandelbrot",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Mandelbrot Membership Tests",
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Run App Logic Unit Tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/TestApps",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build App Logic Unit Tests",
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    }
  ]
}
