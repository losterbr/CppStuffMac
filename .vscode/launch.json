{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Interactive Mandelbrot (No Debugger)",
      "type": "node-terminal",
      "request": "launch",
      "command": "cmake --build --preset default --target Main && \"${workspaceFolder}/.build/default/bin/Main\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Interactive Mandelbrot",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/Main",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Interactive Mandelbrot",
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Run Plotting App (Interactive GNUplot Window)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/Plotting",
      "args": [
        "--gnuplot"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Plotting App",
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Run Mandelbrot Plot (Interactive GNUplot Window)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/Plotting",
      "args": [
        "--mandelbrot",
        "--gnuplot",
        "--width",
        "1000",
        "--height",
        "700",
        "--max-iterations",
        "800",
        "--xmin",
        "-2.5",
        "--xmax",
        "1.0",
        "--ymin",
        "-1.5",
        "--ymax",
        "1.5"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Plotting App",
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Run Plotting App (No GNUplot, Non-interactive)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/Plotting",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Plotting App",
      "environment": [
        {
          "name": "PLOTTING_APP_NO_GNUPLOT",
          "value": "1"
        }
      ],
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Run Complex Number Unit Tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/TestComplexNumbers",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Complex Number Unit Tests",
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    },
    {
      "name": "Run App Logic Unit Tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/default/bin/TestApps",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build App Logic Unit Tests",
      "MIMode": "lldb",
      "stopAtEntry": false,
      "externalConsole": false
    }
  ]
}
