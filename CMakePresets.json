{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Unix Makefiles)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/.build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPPSTUFFMAC_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Unix Makefiles)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/.build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Unix Makefiles)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/.build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPPSTUFFMAC_ENABLE_COVERAGE": "ON",
        "CPPSTUFFMAC_ENABLE_WARNINGS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 8
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 8
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "environment": {
        "CTEST_PARALLEL_LEVEL": "8"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "environment": {
        "CTEST_PARALLEL_LEVEL": "8"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
